# Contact form delivery (Resend, https://resend.com).
# Until these are set, the form tells visitors to use the email link instead of pretending to send.
RESEND_API_KEY=
# Where contact messages are delivered.
CONTACT_TO_EMAIL=
# A sender on a domain verified with Resend, e.g. "Okhare Paul <hello@okharepaul.site>".
CONTACT_FROM_EMAIL=
